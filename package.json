{
  "name": "visor-for-claude-code",
  "displayName": "Visor — media previews for Claude Code",
  "description": "See the images, SVG, HTML and video Claude Code reads or creates, live in a side panel. Before/after, variants, crisp pixel art. Works over Remote-SSH.",
  "version": "0.2.0",
  "publisher": "tato9689",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tato9689/visor-for-claude-code"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "preview",
    "images",
    "image viewer",
    "before after",
    "pixel art",
    "remote-ssh",
    "ai"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "visor",
          "title": "Visor",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "visor": [
        {
          "type": "webview",
          "id": "visor.panel",
          "name": "Previews"
        }
      ]
    },
    "commands": [
      {
        "command": "visor.clear",
        "title": "Clear",
        "category": "Visor",
        "icon": "$(clear-all)"
      },
      {
        "command": "visor.togglePause",
        "title": "Pause / Resume",
        "category": "Visor",
        "icon": "$(debug-pause)"
      },
      {
        "command": "visor.askChange",
        "title": "Pedir un cambio a Claude",
        "category": "Visor",
        "icon": "$(edit)"
      },
      {
        "command": "visor.openFile",
        "title": "Abrir archivo",
        "category": "Visor"
      },
      {
        "command": "visor.copyPath",
        "title": "Copiar ruta",
        "category": "Visor"
      },
      {
        "command": "visor._state",
        "title": "Estado interno (pruebas)",
        "category": "Visor"
      },
      {
        "command": "visor._ui",
        "title": "Abrir visor (pruebas)",
        "category": "Visor"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "visor.togglePause",
          "when": "view == visor.panel",
          "group": "navigation"
        },
        {
          "command": "visor.clear",
          "when": "view == visor.panel",
          "group": "navigation"
        }
      ],
      "webview/context": [
        {
          "command": "visor.askChange",
          "when": "webviewId == 'visor.panel' && cpHasPath",
          "group": "1_claude@1"
        },
        {
          "command": "visor.openFile",
          "when": "webviewId == 'visor.panel' && cpHasPath",
          "group": "2_file@1"
        },
        {
          "command": "visor.copyPath",
          "when": "webviewId == 'visor.panel' && cpHasPath",
          "group": "2_file@2"
        }
      ],
      "commandPalette": [
        {
          "command": "visor.askChange",
          "when": "false"
        },
        {
          "command": "visor.openFile",
          "when": "false"
        },
        {
          "command": "visor.copyPath",
          "when": "false"
        },
        {
          "command": "visor._state",
          "when": "false"
        },
        {
          "command": "visor._ui",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Visor",
      "properties": {
        "visor.maxItems": {
          "type": "number",
          "default": 60,
          "description": "How many previews to load from the session history when the panel opens."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run assets && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run typecheck && npm run build && vsce package --no-dependencies",
    "e2e": "xvfb-run -a -s \"-screen 0 1400x900x24\" node test/e2e/run.js",
    "assets": "node -e \"const fs=require('fs');fs.mkdirSync('media/codicons',{recursive:true});for(const f of ['codicon.css','codicon.ttf'])fs.copyFileSync('node_modules/@vscode/codicons/dist/'+f,'media/codicons/'+f)\""
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "icon": "media/marketplace-icon.png",
  "galleryBanner": {
    "color": "#2b3a67",
    "theme": "dark"
  }
}
